# Supabase project (local: run `supabase start` and copy the values it prints)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the cron route; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GET /api/cron/fetch-context (send as `Authorization: Bearer <secret>`)
CRON_SECRET=
# Login buttons to show (must be enabled in Supabase too): google,facebook,github,apple
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook,apple
# Public identity shown on /privacy and /terms (inlined at build time; set in Render before deploying)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_SITE_URL=https://your-domain.example   (optional; defaults to the request host)
# Error monitoring with Sentry (optional; reporting is OFF until a DSN is set; see docs/monitoring.md)
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only: upload source maps so stack traces show your code
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
